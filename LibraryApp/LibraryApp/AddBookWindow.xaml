<Window x:Class="LibraryApp.AddBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibraryApp"
        mc:Ignorable="d"
        Title="ВтороеОкно" Height="450" Width="800">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Название:"/>
            <TextBox x:Name="TxtTitle" Margin="0,0,0,5"/>

            <TextBlock Text="Автор:"/>
            <TextBox x:Name="TxtAuthor" Margin="0,0,0,5"/>

            <TextBlock Text="Год:"/>
            <TextBox x:Name="TxtYear" Margin="0,0,0,5"/>

            <TextBlock Text="Жанр:"/>
            <TextBox x:Name="TxtGenre" Margin="0,0,0,10"/>

            <Button Content="Сохранить" Width="100" Height="30" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
